# Turael skipping through Autopilot: with the skip plan switched on, the tasks between milestones
# come from Turael (or Spria), the milestone from the master who pays the most, a task in hand is
# never offered for a change at Turael, and each finished task is kept with its time and points.
# Facts (OSRS wiki): "Slayer points": "bonus points are awarded after every 10th, 50th, 100th,
# 250th, and 1,000th completed task", "5x points every 10th task", Konar 18 a task and 90 on a
# 10th, Nieve 12 and 60, Turael 0, and "Tasks assigned by Turael/Spria give no points but do
# contribute to the four needed to start gaining points". "Turael": "using Turael for the rest of
# the tasks to get to every interval of 50 more quickly"; "After a task change is processed, your
# task streak will also be reset to zero!". "Slayer master": Konar asks for 75 combat, Nieve 85,
# Duradel 100 with Shilo Village, which the replay's game has not done, so Nieve heads the ladder
# while Konar pays more. The values are RuneLite's gameval VarPlayerID.SLAYER_COUNT,
# SLAYER_TARGET and VarbitID.SLAYER_MASTER, SLAYER_POINTS, SLAYER_TASKS_COMPLETED.
# The replay's game has no cache tables, so which master each id names comes from Autopilot's own
# save (slayerV1); the ids 1 (Turael) and 9 (Konar) and the task ids are the save's.
saved slayerV1 "{'version':1,'masterId':9,'master':'KONAR','points':500,'streak':37,'lastTask':'Kurask','masters':{'1':'TURAEL','9':'KONAR'}}"
include /replays/scenes/varrock.scene
watch over plaque.shown.over
watch why plaque.shown.why
watch left slayer.amount
skill ATTACK 99
skill STRENGTH 99
skill DEFENCE 99
skill HITPOINTS 99
skill RANGED 99
skill MAGIC 99
skill PRAYER 99
skill SLAYER 87
varbit SLAYER_MASTER 9
varbit SLAYER_POINTS 500
varbit SLAYER_TASKS_COMPLETED 37
tick 5

# The skip plan is off by default: the usual next master.
expect key = slayer:new
expect title = "New task from Nieve"

# Switched on: the 38th is not a milestone, so a quick one from Turael or Spria.
config slayerSkipPlan true
tick 5
expect key = slayer:new
expect title = "Quick task from Turael or Spria"
expect why = "A quick task from Turael or Spria: no points, but the task still counts; 1 more after it, then the 40th from Konar pays 90"

# A Turael task: 15 birds, one a minute.
varbit SLAYER_MASTER 1
varp SLAYER_TARGET 2
varp SLAYER_COUNT_ORIGINAL 15
varp SLAYER_COUNT 15
tick 100
varp SLAYER_COUNT 12
tick 100
varp SLAYER_COUNT 9
tick 100
varp SLAYER_COUNT 6
tick 100
varp SLAYER_COUNT 3
tick 100
expect key = slayer:task
expect left = 3
# Done: the streak moves on, no points.
varp SLAYER_COUNT 0
varbit SLAYER_TASKS_COMPLETED 38
tick 5
expect key = slayer:new
expect title = "Quick task from Turael or Spria"
expect why = "A quick task from Turael or Spria: no points, but the task still counts; then the 40th from Konar pays 90"
# Kept: Turael, 0 points, 300 seconds (five minutes of kills).
expect saved.slayerV1 ~ ,0,300,

# Another quick one: the 39th.
varp SLAYER_COUNT_ORIGINAL 10
varp SLAYER_COUNT 10
tick 100
varp SLAYER_COUNT 5
tick 100
varp SLAYER_COUNT 0
varbit SLAYER_TASKS_COMPLETED 39
tick 5
# The 40th is a milestone: Konar, who pays the most of the masters open, not Nieve.
expect key = slayer:new
expect title = "Milestone task from Konar"
expect why = "Your 40th task in a row is a milestone: take it from Konar for 90 points (5x)"

# A Konar task in hand: nothing suggests a change at Turael.
varbit SLAYER_MASTER 9
varp SLAYER_TARGET 41
varp SLAYER_COUNT_ORIGINAL 40
varp SLAYER_COUNT 40
tick 5
expect key = slayer:task
never why ~ "Turael"
varp SLAYER_COUNT 30
tick 500
varp SLAYER_COUNT 20
tick 500
varp SLAYER_COUNT 10
tick 500
forget
varp SLAYER_COUNT 0
varbit SLAYER_TASKS_COMPLETED 40
tick 1
# The points arrive a tick later; the task is kept with what it paid.
varbit SLAYER_POINTS 590
tick 5
expect saved.slayerV1 ~ ,90,
expect title = "Quick task from Turael or Spria"

# Every 50th only: the 41st onwards wait for the 50th.
config slayerSkipEvery FIFTIETH
tick 5
expect why ~ "then the 50th from Konar pays 270"

# Switched off: back to the usual master.
config slayerSkipPlan false
tick 5
expect title = "New task from Nieve"
