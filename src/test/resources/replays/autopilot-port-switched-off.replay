# Port tasks switched off for a while and on again: a task handed in while Autopilot was not
# watching teaches no xp. Before, the slot's emptying was noticed only on switching back on, and
# every Sailing xp earned while off (here 5,000 from other sailing, then the task's 78) was
# saved as what that task pays.
# Facts as autopilot-port-tasks.replay (OSRS wiki, Courier tasks; RuneLite gameval varbits).
saved portTasksV1 "{'version':1,'sailing':28,'completed':4,'tasks':[{'slot':0,'id':11,'name':'Port Sarim Platebodies','type':'COURIER','level':1,'boardDock':8587,'board':'Port Sarim','fromDock':8587,'from':'Port Sarim','toDock':8588,'to':'The Pandemonium','cargoItem':-1,'cargo':'Platebodies','amount':1}],'xp':{}}"
include /replays/scenes/varrock.scene
watch paid portLog.xp
skill SAILING 28 11000
varbit PORT_TASK_SLOT_0_ID 11
varp PORT_TASKS_COMPLETED 4
tick 5
expect key = port:voyage
expect paid = {}

config portTasks false
tick 5
xp SAILING 16000
varbit PORT_TASK_SLOT_0_ID 0
varp PORT_TASKS_COMPLETED 5
tick 1
xp SAILING 16078
tick 5

config portTasks true
tick 5
expect paid = {}
expect key != port:voyage
